# Auth.js — générer une vraie valeur pour la prod : openssl rand -base64 32
AUTH_SECRET=dev-biiip-dashboard-secret-change-me
AUTH_URL=http://localhost:3000

# MongoDB (optionnel en v1 démo — store mémoire actif sans URI)
# MONGODB_URI=
# MONGODB_DB=dashboard_biiip

# Brevo (email + SMS)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SMS_SENDER=BiiipComedy

# Claude (génération documents + The Biiip Review)
# ANTHROPIC_API_KEY=

# Upload médias (optionnel — sinon stockage Mongo collection `uploads`)
# BLOB_READ_WRITE_TOKEN=

# Publication site public (optionnel)
# SITE_PUBLISH_WEBHOOK_URL=
# SITE_REVALIDATE_TOKEN=
